# Copy to .env.local. Never commit real values.
# Local values come from `npx supabase status -o env` after `npx supabase start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used for absolute URLs (metadata, emails, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend). EMAIL_FROM must be on a domain verified in Resend,
# e.g. "Duratek <samples@example.co.uk>". OWNER_NOTIFY_EMAIL receives new sample requests.
# Online sample requests stay closed in production until these and the service role key are set.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_NOTIFY_EMAIL=
